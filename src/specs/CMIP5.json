  "config": {
    "view": {
      "continuousWidth": 400,
      "continuousHeight": 300
    },
    "legend": {
      "disable": true
    }
  },
  "params": [
    {
      "name": "brush",
      "select": {
        "type": "interval",
        "on": "[pointerdown[event.altKey], pointerup] > pointermove",
        "translate": "[pointerdown[event.altKey], pointerup] > pointermove",
        "zoom": "wheel![event.altKey]"
      }
    },
    {
      "name": "panzoom",
      "select": {
        "type": "interval",
        "on": "[pointerdown[event.ctrlKey], pointerup] > pointermove",
        "translate": "[pointerdown[event.ctrlKey], pointerup] > pointermove!",
        "zoom": "wheel![event.ctrlKey]"
      },
      "bind": "scales"
    },
    {
      "name": "query",
      "select": {
        "type": "point",
        "fields": [
          "dataset"
        ],
        "clear": "dblclick"
      }
    }
  ],
  "hconcat": [
    {
      "title": "Temperature (K)",
      "mark": {
        "type": "circle",
        "size": 150
      },
      "encoding": {
        "x": {
          "field": "tas_bias",
          "type": "quantitative",
          "title": "Bias (RMSD of all gridpoints)",
          "scale": {
            "zero": false
          }
        },
        "y": {
          "field": "tas_change",
          "type": "quantitative",
          "title": "Mean change (Future - Reference)",
          "scale": {
            "zero": false
          }
        },
        "fill": {
          "condition": {
            "param": "brush",
            "field": "model",
            "type": "nominal"
          },
          "value": "lightgray"
        },
        "stroke": {
          "condition": {
            "param": "query",
            "value": "black",
            "empty": false
          },
          "value": "transparent"
        },
        "tooltip": [
          {
            "field": "dataset",
            "type": "nominal"
          },
          {
            "field": "project",
            "type": "nominal"
          },
          {
            "field": "model",
            "type": "nominal"
          },
          {
            "field": "member",
            "type": "nominal"
          },
          {
            "field": "tas_bias",
            "type": "quantitative",
            "title": "bias",
            "format": ".3g"
          },
          {
            "field": "tas_change",
            "type": "quantitative",
            "title": "change",
            "format": ".3g"
          }
        ]
      }
    },
    {
      "title": "Precipitation (mm/day)",
      "mark": {
        "type": "circle",
        "size": 150
      },
      "encoding": {
        "x": {
          "field": "pr_bias",
